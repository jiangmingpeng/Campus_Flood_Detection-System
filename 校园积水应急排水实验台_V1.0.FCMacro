_EX = dict((frozenset((a, b)), r) for (a, b, r) in EXEMPT)


def _ov(a, b, tol=0.5):
    return (min(a[3], b[3]) - max(a[0], b[0]) > tol and
            min(a[4], b[4]) - max(a[1], b[1]) > tol and
            min(a[5], b[5]) - max(a[2], b[2]) > tol)


_CABLE_PREFIX = 'Cable_'


def _is_cable(name):
    """线缆（Cable_*，但不含线槽 Cable_Duct_*）"""
    return name.startswith(_CABLE_PREFIX) and not name.startswith('Cable_Duct_')


def _soft_pair(na, nb):
    """敷设层规则：线缆之间、线缆与线槽之间按敷设关系处理，不判干涉"""
    ca, cb = _is_cable(na), _is_cable(nb)
    if ca and cb:
        return True
    return (ca and nb.startswith('Cable_Duct_')) or (cb and na.startswith('Cable_Duct_'))


def check_model():
    """返回 (errors, exempts)：errors 为未豁免的越界/干涉"""
    errs, oks, seen = [], [], set()
    for name, grp, prims in CHECK:
        for p in prims:
            if p[0] < -1e-6 or p[1] < -1e-6 or p[2] < -1e-6:
                errs.append(u'[越界-负坐标] %s' % name)
            if p[3] > BASE_L + 1e-6 or p[4] > BASE_W + 1e-6:
                errs.append(u'[越界-超出底板] %s  x1=%.1f y1=%.1f' % (name, p[3], p[4]))
    n = len(CHECK)
    for i in range(n):
        for j in range(i + 1, n):
            na, nb = CHECK[i][0], CHECK[j][0]
            if _soft_pair(na, nb):
                continue
            key = frozenset((na, nb))
            hit = False
            for pa in CHECK[i][2]:
                for pb in CHECK[j][2]:
                    if _ov(pa, pb):
                        hit = True
                        break
                if hit:
                    break
            if not hit:
                continue
            if key in _EX:
                if key not in seen:
                    seen.add(key)
                    oks.append((na, nb, _EX[key]))
                continue
            if key in seen:
                continue
            seen.add(key)
            errs.append(u'[干涉] %s <-> %s' % (na, nb))
    return errs, oks



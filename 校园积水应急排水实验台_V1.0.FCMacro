    ('BASE_W', u'mm', u'底板宽度'),
    ('BASE_T', u'mm', u'底板厚度'),
    ('A_TANK_X', u'mm', u'A 浅坑 X 向外部尺寸'),
    ('A_TANK_Y', u'mm', u'A 浅坑 Y 向外部尺寸'),
    ('A_TANK_Z', u'mm', u'A 浅坑总高（顶端绝对高度 = 底板顶面 + 值）'),
    ('A_SINK', u'mm', u'A 槽内底面相对地坪面的下沉量'),
    ('A_CURB_H', u'mm', u'A 朝 C/B 路缘台阶高（自底板顶面算）'),
    ('A_RAMP_RUN', u'mm', u'A 朝 C/B 缓坡水平投影'),
    ('A_WATER_LEVEL', u'mm', u'A 区水位（相对槽内底面）'),
    ('B_X', u'mm', u'B 草坪板 X 向长度'),
    ('B_Y', u'mm', u'B 草坪板 Y 向长度'),
    ('B_PLATE_T', u'mm', u'B 草坪板厚度'),
    ('B_WATER_S3_Z', u'mm', u'B 主浅水面绝对高度'),
    ('B_WATER_S2_Z', u'mm', u'B 低洼观察区水面高度'),
    ('C_TRAY_WATER_LEVEL', u'mm', u'C 浅水盘水位（相对盘内底）'),
    ('P1_BAY_X', u'mm', u'P1 挡水台阶左下角 X'),
    ('P1_BAY_Y', u'mm', u'P1 挡水台阶左下角 Y'),
    ('P1_BAY_LX', u'mm', u'P1 台阶 X 向长度'),
    ('P1_BAY_LY', u'mm', u'P1 台阶 Y 向进深'),
    ('P1_STEP_H', u'mm', u'P1 台阶高度（自底板顶面算）'),
    ('TANK_WATER_LEVEL', u'mm', u'回收水箱水位（相对箱内底）'),
    ('WALL', u'mm', u'水槽壁厚'),
    ('FLOOR_T', u'mm', u'水槽底厚'),
    ('HOSE_R', u'mm', u'软管半径'),
    ('ROAD_T', u'mm', u'道路面层厚度'),
    ('PUMP_L', u'mm', u'移动泵模块长度'),
    ('PUMP_W', u'mm', u'移动泵模块宽度'),
    ('TANK_L', u'mm', u'回收水箱长度'),
    ('TANK_W', u'mm', u'回收水箱宽度'),
    ('TANK_H', u'mm', u'回收水箱高度'),
    ('ELEC_L', u'mm', u'电子控制区长度'),
    ('ELEC_W', u'mm', u'电子控制区宽度'),
    ('CABLE_DUCT_Y', u'mm', u'主线槽南边 Y（设备带与主路之间空档内）'),
    ('CABLE_DUCT_W', u'mm', u'主线槽宽'),
    ('CABLE_DUCT_H', u'mm', u'线槽高'),
    ('CABLE_R', u'mm', u'线缆半径'),
]
SHEET_DERIVED = [
    ('A_WATER_Z', '=BASE_T+FLOOR_T+A_WATER_LEVEL', u'mm', u'A 水面绝对高度（自动）'),
    ('C_TRAY_WATER_Z', '=BASE_T+ROAD_T+FLOOR_T+C_TRAY_WATER_LEVEL', u'mm',
     u'C 浅水盘水面高度（自动）'),
    ('REC_WATER_Z', '=BASE_T+FLOOR_T+TANK_WATER_LEVEL', u'mm', u'回收水箱水面高度（自动）'),
]


def build_sheet(doc):
    s = doc.addObject('Spreadsheet::Sheet', 'Parameters')
    s.Label = u'Parameters 参数表'
    s.set('A1', u'参数名')
    s.set('B1', u'值')
    s.set('C1', u'单位')
    s.set('D1', u'说明')
    r = 2
    for (k, unit, cmt) in SHEET_INPUTS:
        s.set('A%d' % r, k)
        s.set('B%d' % r, str(globals().get(k, 0.0)))
        s.set('C%d' % r, unit)
        s.set('D%d' % r, cmt)
        try:
            s.setAlias('B%d' % r, k)
        except Exception as e:
            App.Console.PrintWarning(u'参数别名失败 %s: %s\n' % (k, e))
        r += 1
    for (k, formula, unit, cmt) in SHEET_DERIVED:
        s.set('A%d' % r, k)
        s.set('B%d' % r, formula)
        s.set('C%d' % r, unit)
        s.set('D%d' % r, cmt)
        try:
            s.setAlias('B%d' % r, k)
        except Exception as e:
            App.Console.PrintWarning(u'参数别名失败 %s: %s\n' % (k, e))
        r += 1
    for col, w in (('A', 170), ('B', 90), ('C', 60), ('D', 260)):
        try:
            s.setColumnWidth(col, w)
        except Exception:
            pass
    return s


def read_sheet(doc):
    """重建前把参数表里的输入值读回来（界面改动才能生效）"""
    out = {}
    s = doc.getObject('Parameters')
    if s is None:
        return out
    try:
        # 参数表结构版本不一致 → 旧表整体作废，避免沿用过期尺寸（如 A 槽高 55 / 水位 30）
        if int(float(s.getContents('PARAM_SCHEMA') or 0)) != int(PARAM_SCHEMA):
            App.Console.PrintWarning(u'参数表结构版本不符（%s != %s），按宏内默认值重建\n'
                                     % (s.getContents('PARAM_SCHEMA'), PARAM_SCHEMA))
            return out
    except Exception:
        return out
    for (k, unit, cmt) in SHEET_INPUTS:
        try:
            v = s.getContents(k)
            if v not in (None, ''):
                out[k] = float(v)
        except Exception:
            pass
    return out


# =============================================================================
# 7. 视图与主流程
# =============================================================================
def set_view():
    if Gui is None:
        return
    try:
        v = Gui.activeDocument().activeView()
        v.viewIsometric()
        try:
            v.fitAll()
        except Exception:
            Gui.SendMsgToActiveView('ViewFit')
    except Exception as e:
        App.Console.PrintWarning(u'视图设置失败（不影响模型）：%s\n' % e)


def main():
    # ---- 打开或新建文档 ----
    doc = None
    saved = {}
    try:
        doc = App.getDocument(DOC_NAME)
        saved = read_sheet(doc)
        for o in reversed(list(doc.Objects)):      # 反向删除，先子后父
            try:
                doc.removeObject(o.Name)
            except Exception:
                pass
    except Exception:
        doc = App.newDocument(DOC_NAME)

    doc.Label = u'校园积水应急排水实验台 V1.0'
    try:
        App.setActiveDocument(doc.Name)
    except Exception:
        pass

    # ---- 应用参数表里改过的值 ----
    g = globals()
    for k, v in saved.items():
        g[k] = v
    g['A_APRON_T'] = g['A_SINK'] + g['FLOOR_T']
    g['A_FLOOR_Z'] = g['BASE_T'] + g['FLOOR_T']
    g['A_APRON_Z'] = g['BASE_T'] + g['A_APRON_T']
    g['A_CURB_Z'] = g['BASE_T'] + g['A_CURB_H']
    g['A_RIM_Z'] = g['BASE_T'] + g['A_TANK_Z']
    g['P1_STEP_Z'] = g['BASE_T'] + g['P1_STEP_H']
    g['A_WATER_Z'] = g['A_FLOOR_Z'] + g['A_WATER_LEVEL']
    g['C_TRAY_WATER_Z'] = g['BASE_T'] + g['ROAD_T'] + g['FLOOR_T'] + g['C_TRAY_WATER_LEVEL']
    g['REC_WATER_Z'] = g['BASE_T'] + g['FLOOR_T'] + g['TANK_WATER_LEVEL']
    del CHECK[:]

    # ---- 建模 ----
    build_sheet(doc)
    G = {}
    for name in GROUPS:
        grp = doc.addObject('App::DocumentObjectGroup', name)
        grp.Label = name
        G[name] = grp

    build_base(doc, G)
    build_A(doc, G)
    build_B(doc, G)
    build_C(doc, G)
    build_D(doc, G)
    build_E(doc, G)
    build_F(doc, G)
    build_G(doc, G)
    build_sensors(doc, G)
    build_hoses(doc, G)
    build_paths(doc, G)
    build_cabling(doc, G)
    build_water(doc, G)
    build_labels(doc, G)

    doc.recompute()

    # ---- 空间检查 ----
    errs, oks = check_model()
    msg = [u'\n============ 校园积水实验台 V1.0 建模完成 ============',
           u'底板 %.0f x %.0f x %.0f mm，对象 %d 个，分组 %d 个' %
           (BASE_L, BASE_W, BASE_T, len(doc.Objects), len(GROUPS)),
           u'硬性干涉/越界：%d 处；设计意图内接触：%d 处' % (len(errs), len(oks))]
    for e in errs:
        msg.append(u'  × ' + e)
    if not errs:
        msg.append(u'  √ 未发现未登记的越界或干涉')
    msg.append(u'提示：切换俯视图请按 3（Draft 顶视）或菜单 View > Standard views > Top')
    msg.append(u'======================================================\n')
    text = '\n'.join(msg)
    App.Console.PrintMessage(text + '\n')

    # ---- 保存 ----
    if SAVE_FCSTD:
        try:
            doc.saveAs(SAVE_PATH)
            App.Console.PrintMessage(u'已保存：%s\n' % SAVE_PATH)
        except Exception as e:
            App.Console.PrintWarning(u'保存失败（请手动 另存为）：%s\n' % e)

    set_view()
    return doc


main()






def build_labels(doc, G):
    g = G['14_Labels']
    for i, (txt, x, y, z) in enumerate(LABELS):
        try:
            a = doc.addObject('App::Annotation', 'Label_%02d' % (i + 1))
            a.LabelText = [txt]
            a.Position = V(x, y, z)
            g.addObject(a)
            vo = a.ViewObject
            try:
                vo.FontSize = 15
            except Exception:
                pass
            try:
                vo.TextColor = (0.05, 0.05, 0.35)
            except Exception:
                pass
        except Exception as e:
            App.Console.PrintWarning('标注创建失败 %s: %s\n' % (txt, e))


